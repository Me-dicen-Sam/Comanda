# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el .env a Git.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# mysql (por defecto) o sqlite (para probar rápido sin instalar MySQL)
DB_ENGINE=mysql
DB_NAME=comanda
DB_USER=comanda
DB_PASSWORD=cambia-esta-clave-de-bd
DB_HOST=127.0.0.1
DB_PORT=3306

# Seguridad y correo
CAPTCHA_ENABLED=True
EMAIL_VERIFICACION_OBLIGATORIA=False
# Para ver los correos en la terminal (desarrollo) deja esta línea tal cual:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviarlos de verdad con Gmail: cambia a smtp y llena estos datos (ver README)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=tu_cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicación_de_16_letras
# DEFAULT_FROM_EMAIL=COMANDA <tu_cuenta@gmail.com>